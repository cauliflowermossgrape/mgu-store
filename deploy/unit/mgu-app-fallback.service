[Unit]
Description=mgu-deploy provisioning fallback for our apps
Before=oapcontroller.service app-privacy.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'B=/usr/lib/oap-mainapp/src/main.bundle.js; [ -f "$B" ] || B=/usr/lib/oap-mainapp/src/main.js; /usr/bin/node /var/opt/mgu-deploy/current/fallback_build.js "$B" /var/opt/mgu-deploy/main.js /var/opt/public/oap/oap_12201/data/custom_apps.json || exit 0; if [ -f /var/opt/app-privacy/current/patch_mainapp.js ]; then /usr/bin/node /var/opt/app-privacy/current/patch_mainapp.js apply --main /var/opt/mgu-deploy/main.js --json >/dev/null || exit 0; fi; /usr/bin/node --check /var/opt/mgu-deploy/main.js || exit 0; mount --bind /var/opt/mgu-deploy/main.js "$B"'
ExecStop=/bin/sh -c 'umount /usr/lib/oap-mainapp/src/main.bundle.js 2>/dev/null || umount /usr/lib/oap-mainapp/src/main.js || true'

[Install]
WantedBy=multi-user.target
